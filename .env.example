# Browser-safe Supabase values (use the current publishable key)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only credentials (SUPABASE_SERVICE_ROLE_KEY can hold a current secret key)
SUPABASE_SERVICE_ROLE_KEY=
GROQ_API_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=

# Exact HTTPS origin of the deployed app, without a trailing slash
APP_URL=

# Keep disabled until the Make scenario, credentials, cron, and platform tests pass
ENABLE_MANAGED_PUBLISHING=false
# Comma-separated allowlist; leave empty for manual-only free operation.
# Do not include x unless X API credits and the X workflow have been approved.
MANAGED_PUBLISH_PLATFORMS=
MAKE_PUBLISH_WEBHOOK_URL=
MAKE_WEBHOOK_API_KEY=
CRON_SECRET=

# Disabled experimental image route
ENABLE_QUOTE_IMAGES=false
POLLINATIONS_API_KEY=
