# Browser-safe Supabase values (use the current publishable key)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only credentials (SUPABASE_SERVICE_ROLE_KEY can hold a current secret key)
SUPABASE_SERVICE_ROLE_KEY=
GROQ_API_KEY=
# Optional; default is openai/gpt-oss-120b. Check the model in your Groq account.
GROQ_MODEL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
# disabled (default), test, or live. Set test/live only with matching credentials.
BILLING_MODE=disabled
# This project's Google provider is configured. Set false in deployments without it.
ENABLE_GOOGLE_AUTH=true
# Turn these on only after custom SMTP and email delivery are tested.
ENABLE_EMAIL_SIGNUP=false
ENABLE_EMAIL_RECOVERY=false

# Exact HTTPS origin of the deployed app, without a trailing slash
APP_URL=

# Keep disabled until the Make scenario, credentials, cron, and platform tests pass
ENABLE_MANAGED_PUBLISHING=false
# Comma-separated allowlist; leave empty for manual-only free operation.
# Do not include x unless X API credits and the X workflow have been approved.
MANAGED_PUBLISH_PLATFORMS=
MAKE_PUBLISH_WEBHOOK_URL=
MAKE_WEBHOOK_API_KEY=
CRON_SECRET=

# Optional AI artwork through Cloudflare Workers AI. Branded PNGs work without it.
# Enable after configuring a Workers AI token and checking the Free allocation.
ENABLE_QUOTE_IMAGES=false
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_API_TOKEN=
