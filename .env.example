# Browser-safe Supabase values (use the current publishable key)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only credentials (SUPABASE_SERVICE_ROLE_KEY can hold a current secret key)
SUPABASE_SERVICE_ROLE_KEY=
GROQ_API_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=

# Exact HTTPS origin of the deployed app, without a trailing slash
APP_URL=

# Keep disabled until the n8n workflow, credentials, cron, and platform tests pass
ENABLE_MANAGED_PUBLISHING=false
N8N_PUBLISH_WEBHOOK_URL=
N8N_PUBLISH_SIGNING_SECRET=
CRON_SECRET=

# Disabled experimental image route
ENABLE_QUOTE_IMAGES=false
POLLINATIONS_API_KEY=
